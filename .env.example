# ==============================================================================
# 🌐 TASK EARN HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env.local` or `.env` in the root folder.
# 2. Fill in your own Supabase project credentials.
# 3. Never commit `.env` or `.env.local` to public repositories!
# ==============================================================================

# 1. SUPABASE CLIENT KEYS (Required for Frontend Web App)
# Find these in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here..."

# 2. SUPABASE SERVICE ROLE KEY (Required for Server-Side Secure Admin APIs)
# Find this in Supabase Dashboard -> Project Settings -> API -> service_role secret
# ⚠️ CAUTION: Keep this secret! Only used inside /api/* server routes.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here..."

# 3. LEGACY VITE COMPATIBILITY (Optional)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here..."

# 4. DIGITAL DRM & DOMAIN WHITELIST (Anti-Clone Protection)
# Comma-separated domains allowed to run this website
NEXT_PUBLIC_ALLOWED_DOMAINS="localhost,127.0.0.1,vercel.app,yourclientdomain.com"

# Set to "true" if you want to completely disable the Anti-Clone killswitch:
NEXT_PUBLIC_DISABLE_KILLSWITCH="false"
